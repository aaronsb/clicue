# Maintainer: Aaron Bockelie <aaronsb@gmail.com>
# Source of truth lives in the clicue repo at packaging/aur/PKGBUILD;
# `make publish` verifies pkgver against Cargo.toml, refreshes sha256sums,
# regenerates .SRCINFO, and pushes to AUR. Edit there, not in the AUR clone.
pkgname=clicue
pkgver=0.1.0
pkgrel=1
pkgdesc="Live, contextual command guidance for zsh — a daemon behind a generated shim"
arch=('x86_64' 'aarch64')
url="https://github.com/aaronsb/clicue"
license=('MIT')
depends=('zsh' 'gcc-libs')
makedepends=('cargo')
optdepends=('man-db: glosses for system commands (whatis)')
install=clicue.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('34adf164a87dbff0c89ac709088633ab87d0fb56f250c1466f477885a084a457')

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo build --release --locked -p clicue
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --release --locked -p clicue --lib
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/clicue "$pkgdir/usr/bin/clicue"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
